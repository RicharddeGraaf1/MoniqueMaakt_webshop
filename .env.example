# PostgreSQL; in Coolify de interne URL van de database-container
DATABASE_URL="postgresql://user:wachtwoord@localhost:5432/moniquemaakt"

# Mollie: test_... voor testen, live_... voor productie
MOLLIE_API_KEY="test_..."

# Publiek adres van de shop, voor de Mollie redirect- en webhook-URL
APP_URL="http://localhost:3000"

# Lange willekeurige string, bv. `openssl rand -hex 32`
JWT_SECRET=""
